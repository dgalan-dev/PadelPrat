<?xml version="1.0" encoding="utf-8"?>
<!--
    Bola de pádel lima (#B8E63A) con sus dos costuras, como la del login. Va dentro de la zona segura del icono
    adaptativo (círculo de 66 dp en el centro de 108 dp) para que se vea entera con cualquier forma de máscara.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sombra suave para despegar la bola del fondo -->
    <path
        android:fillColor="#33000000"
        android:pathData="M30,56a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" />
    <path
        android:fillColor="#FFB8E63A"
        android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" />
    <!-- Costuras, recortadas a la silueta de la bola para que no sobresalgan -->
    <group>
        <clip-path android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" />
        <path
            android:pathData="M36.7,34.6a26,26 0,0 1,0 38.8"
            android:strokeWidth="3.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M71.3,34.6a26,26 0,0 0,0 38.8"
            android:strokeWidth="3.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
    </group>
</vector>
