<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad en Android 11 y anteriores.
   La sesión (cookies cifradas y su clave) no se copia: la clave maestra vive en el Keystore del móvil y no viaja
   con la copia, así que en otro móvil no se podría descifrar.
   Los avisos de las reservas tampoco: se rehacen solos al leer Mis reservas. Ni la copia de Mis reservas para verlas
   sin conexión, que se vuelve a leer de la web. Ni lo último visto de las reservas del amigo, que se vuelve a leer en
   Firestore.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session_cookies.bin" />
    <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
    <exclude domain="file" path="datastore/reminders.json" />
    <exclude domain="file" path="datastore/reservations_cache.json" />
    <exclude domain="file" path="datastore/friend_alerts.json" />
</full-backup-content>
