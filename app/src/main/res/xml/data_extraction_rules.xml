<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad y transferencia entre móviles en Android 12 y posteriores.
   La sesión (cookies cifradas y su clave), los avisos de las reservas, la copia de Mis reservas y lo último visto de
   las del amigo no se copian: ver backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session_cookies.bin" />
        <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/reminders.json" />
        <exclude domain="file" path="datastore/reservations_cache.json" />
        <exclude domain="file" path="datastore/friend_alerts.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session_cookies.bin" />
        <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/reminders.json" />
        <exclude domain="file" path="datastore/reservations_cache.json" />
        <exclude domain="file" path="datastore/friend_alerts.json" />
    </device-transfer>
</data-extraction-rules>
