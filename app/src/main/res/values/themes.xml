<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PadelPrat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Pantalla de arranque (core-splashscreen): se mantiene mientras se comprueba si hay sesión -->
    <style name="Theme.PadelPrat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PadelPrat</item>
    </style>
</resources>