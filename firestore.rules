rules_version = '2';

// Reservas compartidas entre los usuarios de la app (ver docs/plan-reservas-amigo.md).
// Quién es miembro se decide en la consola, creando members/{uid}: la app no puede escribir ahí.
// Desplegar con: npx -y firebase-tools@latest deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /members/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    // Cada uno publica sus próximas reservas en el suyo y lee el del otro
    match /reservations/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }
  }
}
